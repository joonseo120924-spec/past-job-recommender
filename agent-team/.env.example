# agent-team/.env 로 복사해서 쓴다. .env 는 커밋되지 않는다.

# --- Managed Agents ---
# `python -m shipyard env apply` 가 출력하는 값을 넣는다.
SHIPYARD_ENVIRONMENT_ID=
# API 키가 Default 워크스페이스에 없으면 실제 워크스페이스 ID로 바꾼다 (Console 트레이스 링크용).
SHIPYARD_WORKSPACE_ID=default
# 세션당 지출 상한(USD). 비워두면 상한 없음 — 자율 실행에서는 권하지 않는다.
SHIPYARD_SESSION_BUDGET_USD=50

# --- 앱 코드가 사는 저장소 ---
SHIPYARD_REPO_URL=
SHIPYARD_REPO_BRANCH=main
SHIPYARD_GITHUB_TOKEN=

# --- 백엔드 (Supabase) ---
# 이 둘은 클라이언트에 실려 나가도록 설계된 값이라 앱 번들에 들어간다.
# 다만 공개 키의 권한 경계는 RLS 하나뿐이다 — RLS를 켜지 않은 테이블은
# 이 키를 가진 누구에게나 열려 있다는 뜻이다.
SHIPYARD_SUPABASE_URL=https://adbrmhtsejtawpwyuihw.supabase.co
SHIPYARD_SUPABASE_PUBLISHABLE_KEY=sb_publishable_8Pr33-HggvA39VExv29Fsw_89TDhKLP
# service_role 키는 여기 넣지 마라. 이 팀은 쓰지 않고, doctor 가 설정을 거부한다.

# --- 빌드 CI (샌드박스 밖) ---
# GitHub Actions 백엔드 (macOS 러너로 iOS 빌드). 비워두면 로컬 eas CLI를 쓴다.
SHIPYARD_GITHUB_OWNER=
SHIPYARD_GITHUB_REPO=
SHIPYARD_BUILD_WORKFLOW=build.yml

# --- 개발 편의 ---
# true 로 두면 휴먼 게이트를 자동 통과한다. 스토어 제출 게이트는 예외로 항상 사람이 승인한다.
SHIPYARD_AUTO_APPROVE_GATES=false
